                "title": "Mateus (Levi), ex-cobrador de impostos e discípulo de Jesus",
                "text": null,
                "proof_texts": []
              },
              {
                "icon": null,
                "label": "Preparo",
                "title": "Lidava com romanos e judeus: domínio de língua e cultura",
                "text": null,
                "proof_texts": []
              },
              {
                "icon": null,
                "label": "Destinatários",
                "title": "Igreja de Antioquia da Síria, mista de judeus e gentios",
                "text": null,
                "proof_texts": []
              },
              {
                "icon": null,
                "label": "Data",
                "title": "Antes de 70 d.C.",
                "text": null,
