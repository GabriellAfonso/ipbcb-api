        ]
      },
      {
        "title": "Desafio Devocional (Aplicação Prática)",
        "icon": "hands_praying",
        "blocks": [
          {
            "type": "cards",
            "items": [
              {
                "icon": "shield",
                "label": null,
                "title": "Leia Naum",
                "text": "Quando a maldade do mundo parecer invencível; o livro lhe garantirá que Deus é o escudo dos justos e o ponto final de todo opressor.",
                "proof_texts": []
              },
              {
                "icon": "plant",
                "label": null,
                "title": "Leia Habacuque",
                "text": "Quando suas orações parecerem não ter resposta. Ele nos ensina a transformar o desespero das \"figueiras sem flores\" em uma adoração profunda e inabalável.",
                "proof_texts": []
              },
              {
                "icon": "heart",
                "label": null,
                "title": "Leia Sofonias",
                "text": "Para ser despertado do comodismo espiritual e maravilhar-se com um Deus que não apenas perdoa, mas que canta de alegria por você!",
                "proof_texts": []
              }
            ]
          }
        ]
