# ─── Django ───────────────────────────────────────────────────────────────────
# DJANGO_ENV alone selects the settings module. Do NOT add DJANGO_SETTINGS_MODULE here:
# asgi.py uses setdefault, so a value in .env silently wins over DJANGO_ENV and can boot
# production on dev settings. The compose files pin both explicitly.
DJANGO_ENV=dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id

# ─── Firebase Cloud Messaging (push) ──────────────────────────────────────────
# Service account key of the app's Firebase project, as one base64 line:
#   base64 -w0 key.json   (then delete key.json)
# Empty disables push notifications; everything else keeps working.
FCM_SERVICE_ACCOUNT_JSON_BASE64=

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=ipbcb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── Sentry (production only) ────────────────────────────────────────────────
SENTRY_DSN=

# Grafana reads .env.grafana instead — see .env.grafana.example.
