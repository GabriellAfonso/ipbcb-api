### Registrar usuário
# @name register
POST {{baseUrl}}/api/auth/register/
Content-Type: {{json}}

{
  "username": "teste_account",
  "first_name": "Teste",
  "last_name": "JWT",
  "password": "12345678",
  "password_confirm": "12345678",
  "recovery_email": "teste@example.com"
}

###
# @name passwordRecoveryRequest
POST {{baseUrl}}/api/auth/password-recovery/request/
Content-Type: {{json}}

{
  "email": "teste@example.com"
}

###
# @name passwordRecoveryConfirm
POST {{baseUrl}}/api/auth/password-recovery/confirm/
Content-Type: {{json}}

{
  "email": "teste@example.com",
  "code": "123456",
  "new_password": "nova-senha",
  "new_password_confirm": "nova-senha"
}

### Login
# @name login
POST {{baseUrl}}/api/auth/login/
Content-Type: {{json}}

{
  "username": "teste_account",
  "password": "12345678"
}
> {%
    client.global.set("auth_token", response.body.access);
%}
### Refresh Token
# @name refresh
POST {{baseUrl}}/api/auth/refresh/
Content-Type: {{json}}

{
  "refresh": "{{login.response.body.refresh}}"
}